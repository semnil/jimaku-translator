{
  "name": "jimaku-translator",
  "version": "1.1.0",
  "description": "Real-time OBS subtitle system: VBAN audio → Whisper recognition → OBS WebSocket",
  "author": "semnil",
  "main": "dist/electron.js",
  "scripts": {
    "build": "tsc && npm run copy-ui",
    "copy-ui": "node -e \"const fs=require('fs');fs.mkdirSync('dist/ui',{recursive:true});fs.copyFileSync('src/ui/index.html','dist/ui/index.html')\"",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "electron": "npm run build && electron .",
    "electron:dev": "tsx src/electron.ts",
    "clean:dist": "node build/clean-dist.cjs",
    "dist:win": "npm run clean:dist && npm run build && node --env-file-if-exists=.env node_modules/electron-builder/out/cli/cli.js --win --publish=never",
    "dist:mac": "npm run clean:dist && npm run build && node --env-file-if-exists=.env node_modules/electron-builder/out/cli/cli.js --mac --publish=never && node build/set-min-system-version.cjs && node --env-file-if-exists=.env build/notarize-dmg.cjs",
    "dist:mac:app": "npm run clean:dist && npm run build && node --env-file-if-exists=.env node_modules/electron-builder/out/cli/cli.js --mac --dir --publish=never",
    "dist:mac:unsigned": "npm run clean:dist && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false node node_modules/electron-builder/out/cli/cli.js --mac --publish=never --config.mac.identity=null --config.mac.notarize=false && node build/set-min-system-version.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "obs-websocket-js": "^5.0.6",
    "onnxruntime-node": "^1.31.1",
    "smol-toml": "^1.9.1"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "brace-expansion@>=5.0.2 <5.0.6": "^5.0.6",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.2",
    "js-yaml@4": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.semnil.jimaku-translator",
    "productName": "Jimaku Translator",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "files": [
      "dist/*.js",
      "dist/audio/**/*.js",
      "dist/obs/**/*.js",
      "dist/recognition/**/*.js",
      "dist/subtitle/**/*.js",
      "dist/ui/**/*",
      "dist/vban/**/*.js",
      "models/**/*",
      "config.toml",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "config.toml",
        "to": "config.toml"
      },
      {
        "from": "THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "electronLanguages": [
        "en",
        "ja"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "jimaku-translator connects to OBS Studio and VBAN audio sources on your local network.",
        "CFBundleIconName": "AppIcon"
      }
    },
    "afterPack": "build/afterPack.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "THIRD_PARTY_LICENSES.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "semnil",
        "repo": "jimaku-translator"
      }
    ]
  }
}
